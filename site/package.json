{
  "name": "dalibre-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sdk && astro dev",
    "build": "npm run sdk && astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "sdk": "mkdir -p public/sdk && cp ../sdk/dalibre.d.ts ../sdk/plugin.schema.json ../sdk/template/jsconfig.json public/sdk/"
  },
  "dependencies": {
    "@lucide/astro": "^1.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}

---
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { Code } from "astro:components";
import AppWindow from "../components/AppWindow.astro";
import SendToDevice from "../components/SendToDevice.astro";
import Seo from "../components/Seo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { dalibreMB } from "../lib/app-size";
import { release } from "../lib/release";

// calibre 9.18 as installed on macOS (du -sm calibre.app).
const calibreMB = 1397;
const ratio = Math.round(calibreMB / dalibreMB);
const dalibrePct = ((dalibreMB / calibreMB) * 100).toFixed(2);

const title = "Dalibre — a lightweight calibre alternative for your e-books";
const description = `Dalibre is a lightweight calibre alternative: a fast, native e-book manager for macOS, Windows and Linux that opens your existing calibre library.`;

// Shown in the FAQ section and given to search engines as FAQPage.
const faq = [
  {
    q: "Is Dalibre a calibre alternative?",
    a: `Yes, for managing your e-book library. Dalibre does the everyday part of calibre (browsing, searching, editing metadata, getting books and sending them to your e-reader) in a native app that is ${ratio}× smaller. Format conversion is in the works; calibre's e-book editor is out of scope.`,
  },
  {
    q: "Do I have to migrate my calibre library?",
    a: "No. Dalibre reads and writes calibre's own library format (metadata.db, its folder layout and metadata.opf), so it opens the library you already have. Nothing to import, nothing to export.",
  },
  {
    q: "Can I use Dalibre and calibre on the same library?",
    a: "Yes. Both apps work on the same files, so you can open your library in either one, any day, and keep calibre for the jobs Dalibre doesn't do.",
  },
  {
    q: "Does Dalibre convert e-book formats?",
    a: "Not yet. We are working on it. Until then, keep using calibre on the same library to convert between EPUB, MOBI, AZW3 or PDF, or ask an AI agent connected over MCP: it can convert a book with calibre's ebook-convert and add the result to it.",
  },
  {
    q: "How do I get books onto my e-reader?",
    a: "Turn on sharing and Dalibre serves your library over OPDS on your Wi-Fi. Reading apps such as KOReader, Moon+ Reader, Thorium and KyBook browse it and download the books you pick. No cables, no cloud, no account.",
  },
  {
    q: "Can AI agents use my library?",
    a: "Yes. Turn on MCP and agents such as Claude Code, Claude Desktop and Cursor can search your library, edit metadata, add books and convert formats with the tools they already have. Only programs on your computer can connect, with a token, and Dalibre shows every call they make.",
  },
  {
    q: "Which platforms does Dalibre run on?",
    a: "macOS, Windows and Linux. Dalibre is a single native binary written in Go: no webview, no bundled Python, no runtime to install.",
  },
  {
    q: "Does Dalibre run calibre plugins?",
    a: "No. Dalibre has its own plugins: small, sandboxed JavaScript modules that add places to get books and to look up metadata. Anyone can write one.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Dalibre",
    url: "https://dalibre.randynamic.org/",
    image: "https://dalibre.randynamic.org/icon.png",
    description,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS, Windows, Linux",
    fileSize: `${dalibreMB}MB`,
    featureList: [
      "Opens existing calibre libraries",
      "Edit metadata and fetch it from online sources",
      "Get books from catalogues and OPDS servers",
      "Send books to e-readers over OPDS",
      "Sandboxed JavaScript plugins",
      "MCP server for AI agents such as Claude Code, Claude Desktop and Cursor",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];

const manifest = `{
  "id": "com.example.books",
  "name": "Example Books",
  "api": 1,
  "capabilities": {
    "bookSource": {}
  },
  "permissions": {
    "hosts": ["books.example.com"]
  }
}`;

const code = `// @ts-check
export async function search({ text, page }) {
  const res = await dalibre.fetch(
    \`https://books.example.com/api?q=\${text}&p=\${page}\`
  );
  const { books, next } = await res.json();
  return {
    items: books.map((b) => ({
      id: b.id,
      title: b.title,
      authors: b.authors,
      cover: b.cover,
      formats: [{ format: "EPUB", url: b.epub }],
    })),
    hasMore: Boolean(next),
  };
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} schema={schema} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans">
    <div class="grain pointer-events-none fixed inset-0 z-50 opacity-70"></div>

    <!-- Nav -->
    <SiteHeader />

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden">
        <div
          class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
          style="background: radial-gradient(closest-side, #e1e9ff, transparent);"
        ></div>

        <div class="relative mx-auto max-w-6xl px-5 pt-20 pb-10 sm:pt-28">
          <p class="rise font-mono text-xs tracking-widest text-sand-11 uppercase">
            The lightweight calibre alternative
          </p>
          <h1
            class="rise mt-5 max-w-4xl font-serif text-[52px] leading-[0.98] tracking-tight sm:text-[88px]"
            style="animation-delay:.08s"
          >
            Your calibre library,<br />
            <em class="text-accent">light as a paperback.</em>
          </h1>
          <p
            class="rise mt-7 max-w-xl text-lg leading-relaxed text-sand-11"
            style="animation-delay:.16s"
          >
            Dalibre is a calm, fast calibre alternative for your e-books. It
            opens the calibre library you already have, in a single
            native app for macOS, Windows and Linux, and grows with
            plugins anyone can write.
          </p>
          <div class="rise relative z-20 mt-9 flex flex-wrap items-center gap-3" style="animation-delay:.24s">
            <div class="flex items-stretch rounded-full bg-ink text-sm font-medium text-paper">
              <a
                id="download"
                href={release.downloads[0].url}
                class="rounded-l-full py-2.5 pr-4 pl-5 transition hover:bg-black"
              >
                Download for <span data-download-label>{release.downloads[0].os}</span>
              </a>
              <details class="download-menu relative">
                <summary
                  aria-label="Other platforms"
                  class="flex h-full cursor-pointer list-none items-center rounded-r-full border-l border-white/20 pr-4 pl-3 transition hover:bg-black"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="absolute top-full left-0 mt-2 w-64 rounded-2xl border border-sand-6 bg-paper p-1.5 text-ink shadow-lg">
                  {release.downloads.map((d) => (
                    <a
                      href={d.url}
                      data-download={d.id}
                      data-os={d.os}
                      data-size={d.size}
                      class="flex items-center justify-between rounded-xl px-3 py-2 hover:bg-sand-3"
                    >
                      <span>{d.label}</span>
                      <span class="font-mono text-xs text-sand-11">{d.size}</span>
                    </a>
                  ))}
                  <div class="mx-3 my-1 h-px bg-sand-5" aria-hidden="true"></div>
                  <a href={release.page} class="block rounded-xl px-3 py-2 text-sand-11 hover:bg-sand-3 hover:text-ink">
                    All downloads →
                  </a>
                </div>
              </details>
            </div>
            <span class="font-mono text-xs text-sand-11">
              <span data-download-size>{release.downloads[0].size}</span> · v{release.version}
            </span>
          </div>
          <div class="rise mt-8" style="animation-delay:.28s">
            <p class="font-mono text-[10px] tracking-widest text-sand-9 uppercase">Sponsored by</p>
            <a
              href="https://nowdex.app/?utm_source=dalibre&utm_medium=referral&utm_campaign=sponsor"
              target="_blank"
              rel="noopener"
              class="group mt-2.5 inline-flex items-center gap-3 grayscale transition hover:grayscale-0"
            >
              <img src="/sponsors/nowdex.png" alt="" width="32" height="32" class="size-8 rounded-[8px] opacity-70 transition group-hover:opacity-100" />
              <span class="text-sm leading-tight">
                <span class="block font-medium text-sand-11 transition group-hover:text-ink">nowdex.app</span>
                <span class="block text-sand-9">Display AI agent quota on your phone</span>
              </span>
            </a>
          </div>

          <!-- App window, redrawn from the Figma file -->
          <div class="rise mt-16 sm:mt-20" style="animation-delay:.32s">
            <div class="mb-4 flex justify-end text-xs text-sand-11">
              <div class="flex rounded-full border border-sand-6 bg-paper p-0.5" role="group" aria-label="Window theme">
                <button data-theme-btn="light" aria-pressed="true" class="theme-btn rounded-full px-3 py-1 font-medium">Light</button>
                <button data-theme-btn="dark" aria-pressed="false" class="theme-btn rounded-full px-3 py-1 font-medium">Dark</button>
              </div>
            </div>
            <AppWindow />
          </div>
        </div>
      </section>

      <!-- Lightweight -->
      <section id="light" class="scroll-mt-14 border-t border-sand-4 bg-paper-2">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:py-32">
          <div class="grid gap-14 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
            <div>
              <p class="font-mono text-xs tracking-widest text-accent uppercase">01 · Lightweight</p>
              <h2 class="mt-4 font-serif text-5xl leading-[1.02] tracking-tight sm:text-6xl">
                {ratio}× smaller<br />than calibre.
              </h2>
              <p class="mt-6 max-w-md leading-relaxed text-sand-11">
                calibre is a toolbox for everything you could do to an e-book.
                Dalibre does the everyday part, managing your library, and does
                it in one native binary: written in Go, no webview, no bundled
                Python, no runtime to install.
              </p>
            </div>

            <div class="size-chart self-center">
              <div class="space-y-9">
                <div>
                  <div class="mb-2.5 flex items-baseline justify-between text-sm">
                    <span class="font-medium">calibre <span class="text-sand-9">9.18</span></span>
                    <span class="font-mono text-sand-11">{(calibreMB / 1024).toFixed(2)} GB</span>
                  </div>
                  <div class="h-12 overflow-hidden rounded-lg bg-sand-3">
                    <div
                      class="bar h-full rounded-lg"
                      style="background: repeating-linear-gradient(-45deg, #bcbbb5 0 6px, #cfceca 6px 12px);"
                    ></div>
                  </div>
                </div>
                <div>
                  <div class="mb-2.5 flex items-baseline justify-between text-sm">
                    <span class="font-medium">Dalibre <span class="text-sand-9">{release.version}</span></span>
                    <span class="font-mono text-accent">{dalibreMB} MB</span>
                  </div>
                  <div class="relative h-12 rounded-lg bg-sand-3">
                    <div
                      class="bar h-full rounded-lg bg-accent"
                      style={`width:max(${dalibrePct}%, 10px); animation-delay:.3s`}
                    ></div>
                    <span class="absolute top-1/2 left-6 -translate-y-1/2 text-sm text-sand-11">
                      ← that's the whole app
                    </span>
                  </div>
                </div>
              </div>
              <p class="mt-6 text-xs text-sand-9">
                Size on disk on macOS: calibre.app 9.18 as installed, and the Dalibre release binary.
              </p>

              <table class="mt-12 w-full text-left text-[15px]">
                <thead>
                  <tr class="border-b border-sand-6 text-xs text-sand-11">
                    <th class="py-3 pr-4 font-normal"></th>
                    <th class="w-20 py-3 text-center font-medium sm:w-24">calibre</th>
                    <th class="w-20 py-3 text-center font-medium text-accent sm:w-24">Dalibre</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-sand-6">
                  <tr>
                    <td class="py-3.5 pr-4">Opens your calibre library, no import</td>
                    <td class="text-center text-sand-11">✓</td>
                    <td class="text-center font-medium text-accent">✓</td>
                  </tr>
                  <tr>
                    <td class="py-3.5 pr-4">Edits show up in the other app</td>
                    <td class="text-center text-sand-11">✓</td>
                    <td class="text-center font-medium text-accent">✓</td>
                  </tr>
                  <tr>
                    <td class="py-3.5 pr-4">Sends books to KOReader over Wi-Fi</td>
                    <td class="text-center text-sand-11">✓</td>
                    <td class="text-center font-medium text-accent">✓</td>
                  </tr>
                  <tr>
                    <td class="py-3.5 pr-4">Converts formats</td>
                    <td class="text-center text-sand-11">✓</td>
                    <td class="text-center text-xs text-sand-9">Not yet</td>
                  </tr>
                  <tr class="border-b border-sand-6">
                    <td class="py-3.5 pr-4">Size on disk</td>
                    <td class="text-center font-mono text-xs text-sand-11">{(calibreMB / 1024).toFixed(2)} GB</td>
                    <td class="text-center font-mono text-xs text-accent">{dalibreMB} MB</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Plugins -->
      <section id="plugins" class="scroll-mt-14 border-t border-sand-4">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:py-32">
          <div class="max-w-2xl">
            <p class="font-mono text-xs tracking-widest text-violet uppercase">02 · Extensible</p>
            <h2 class="mt-4 font-serif text-6xl leading-[0.98] tracking-tight sm:text-8xl">
              Plugins bring<br /><em class="text-violet">the books in.</em>
            </h2>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-sand-11">
              Plugins add places to get books and to look them up: open
              catalogues, OPDS servers, the server in your closet. Every one
              shows up in the same calm UI, because plugins give data and
              never draw it.
            </p>
          </div>

          <div class="mt-14 grid gap-5 md:grid-cols-2">
            <article class="rounded-2xl border border-sand-6 bg-paper p-7">
              <div class="flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
              </div>
              <h3 class="mt-5 text-lg font-medium">Book sources</h3>
              <p class="mt-2 leading-relaxed text-sand-11">
                Search and browse a catalogue from <b class="font-medium text-ink">Get books</b>.
                Dalibre downloads the file and adds it to your library with
                the metadata the plugin gave. OPDS catalogs work too.
              </p>
              <p class="mt-5 font-mono text-xs text-sand-9">Built in: Project Gutenberg</p>
            </article>
            <article class="rounded-2xl border border-sand-6 bg-paper p-7">
              <div class="flex size-10 items-center justify-center rounded-lg bg-[#f4f0fe] text-violet">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
              </div>
              <h3 class="mt-5 text-lg font-medium">Metadata sources</h3>
              <p class="mt-2 leading-relaxed text-sand-11">
                Look a book up by title, authors and identifiers. Candidates
                show up in <b class="font-medium text-ink">Fetch metadata</b>, next to your own
                values; you pick which fields to take.
              </p>
              <p class="mt-5 font-mono text-xs text-sand-9">Built in: NeoDB (Douban, Goodreads and more)</p>
            </article>
          </div>

          <!-- Writing one -->
          <div class="mt-20 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <h3 class="text-xl font-medium tracking-tight sm:text-2xl">Writing one takes a folder, a JSON file and some JavaScript.</h3>
            <p class="shrink-0 text-sm text-sand-11">No build step, nothing to install.</p>
          </div>
          <div class="mt-6 overflow-hidden rounded-2xl bg-ink text-[#eeeeec] shadow-2xl shadow-ink/10">
            <div class="flex items-center gap-1 border-b border-white/10 px-4 text-xs">
              <span class="mr-3 flex gap-1.5">
                <i class="size-2.5 rounded-full bg-white/15"></i>
                <i class="size-2.5 rounded-full bg-white/15"></i>
                <i class="size-2.5 rounded-full bg-white/15"></i>
              </span>
              <button data-tab="0" class="tab border-b-2 border-[#9eb1ff] px-3 py-3 font-mono text-white">main.js</button>
              <button data-tab="1" class="tab border-b-2 border-transparent px-3 py-3 font-mono text-white/50 hover:text-white">plugin.json</button>
            </div>
            <div class="overflow-x-auto p-6 font-mono text-[13px] leading-6">
              <div data-panel="0" class="panel"><Code code={code} lang="js" theme="vesper" /></div>
              <div data-panel="1" class="panel hidden"><Code code={manifest} lang="json" theme="vesper" /></div>
            </div>
          </div>

          <ul class="mt-10 grid gap-x-10 gap-y-6 text-sm sm:grid-cols-3">
            <li>
              <p class="font-medium">Sandboxed</p>
              <p class="mt-1 leading-relaxed text-sand-11">Runs in QuickJS inside Dalibre, with only the hosts and library access it asks you for.</p>
            </li>
            <li>
              <p class="font-medium">Typed</p>
              <p class="mt-1 leading-relaxed text-sand-11"><code class="font-mono text-xs">dalibre.d.ts</code> gives completions and checks in any editor. TypeScript welcome.</p>
            </li>
            <li>
              <p class="font-medium">Live reload</p>
              <p class="mt-1 leading-relaxed text-sand-11">Add a plugin from a folder and Dalibre reloads it each time you save. Share it from a GitHub repository.</p>
            </li>
          </ul>

          <div class="mt-12 flex flex-wrap items-center gap-3">
            <a
              href="/docs/plugins/#quick-start"
              class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition hover:bg-black"
            >
              Build your first plugin →
            </a>
            <a
              href="/docs/plugins/"
              class="rounded-full border border-sand-6 bg-paper px-5 py-2.5 text-sm font-medium transition hover:border-sand-9"
            >
              Read the plugin docs
            </a>
          </div>
        </div>
      </section>

      <!-- MCP -->
      <section id="mcp" class="scroll-mt-14 border-t border-sand-4 bg-paper-2">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:py-32">
          <div class="max-w-2xl">
            <p class="font-mono text-xs tracking-widest text-accent uppercase">03 · MCP</p>
            <h2 class="mt-4 font-serif text-5xl leading-[1.02] tracking-tight sm:text-6xl">
              Your AI agent<br /><em class="text-accent">knows your shelves.</em>
            </h2>
            <p class="mt-6 max-w-xl leading-relaxed text-sand-11">
              Turn on MCP and Claude Code, Claude Desktop, Cursor or any MCP
              client can search your library, fix its metadata, add books, and
              convert formats with the tools it already has. It stays on your
              computer, and Dalibre shows every call it makes.
            </p>
          </div>

          <div class="mt-14 grid gap-5 lg:grid-cols-[1.3fr_1fr]">
            <!-- The agent's side -->
            <div class="overflow-hidden rounded-2xl bg-ink text-[#eeeeec] shadow-2xl shadow-ink/10">
              <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3 text-xs">
                <span class="flex gap-1.5">
                  <i class="size-2.5 rounded-full bg-white/15"></i>
                  <i class="size-2.5 rounded-full bg-white/15"></i>
                  <i class="size-2.5 rounded-full bg-white/15"></i>
                </span>
                <span class="font-mono text-white/50">Your agent</span>
              </div>
              <div class="space-y-4 overflow-x-auto p-6 font-mono text-[13px] leading-6">
                <p class="text-white"><span class="text-[#9eb1ff]">›</span> Tag every Liu Cixin book “Hard SF”, and make an AZW3 of Dune for my Kindle.</p>
                <ul class="space-y-1.5 whitespace-nowrap text-white/60">
                  <li><span class="text-[#3dd68c]">●</span> <span class="text-white">search_books</span> {"{"}"author": "Liu Cixin"{"}"} <span class="text-white/40">→ 3 books</span></li>
                  <li><span class="text-[#3dd68c]">●</span> <span class="text-white">update_books</span> {"{"}"ids": [3, 4, 9], "patch": {"{"}"add_tags": ["Hard SF"]{"}"}{"}"}</li>
                  <li><span class="text-[#3dd68c]">●</span> <span class="text-white">get_book</span> {"{"}"id": 5{"}"} <span class="text-white/40">→ Dune - Frank Herbert.epub</span></li>
                  <li><span class="text-[#3dd68c]">●</span> <span class="text-white">$</span> ebook-convert "Dune - Frank Herbert.epub" /tmp/Dune.azw3</li>
                  <li><span class="text-[#3dd68c]">●</span> <span class="text-white">add_format</span> {"{"}"id": 5, "path": "/tmp/Dune.azw3"{"}"}</li>
                </ul>
                <p class="text-white">Done: 3 books are tagged “Hard SF”, and Dune now has an AZW3.</p>
              </div>
            </div>

            <!-- Dalibre's side: the MCP popover -->
            <div class="rounded-2xl border border-sand-6 bg-paper p-2 text-sm shadow-xl shadow-ink/5">
              <div class="flex items-center gap-3 px-3 pt-2 pb-3">
                <div class="min-w-0 flex-1">
                  <p class="font-semibold">MCP</p>
                  <p class="text-xs text-green">Running · can change books</p>
                </div>
                <span class="flex h-4 w-7 items-center justify-end rounded-full bg-accent px-0.5" aria-hidden="true"><i class="size-3 rounded-full bg-white"></i></span>
              </div>
              <div class="border-t border-sand-4 px-3 py-3">
                <p class="text-[11px] font-semibold tracking-wider text-sand-9 uppercase">Agents</p>
                <div class="mt-2 flex items-center gap-2.5">
                  <span class="flex size-6 items-center justify-center rounded-md bg-[#cc7852] text-[10px] font-semibold text-white">CC</span>
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">Claude Code</p>
                    <p class="text-xs text-green">Working now · 5 calls</p>
                  </div>
                  <i class="size-2 rounded-full bg-green"></i>
                </div>
              </div>
              <div class="border-t border-sand-4 px-3 pt-3 pb-1">
                <p class="text-[11px] font-semibold tracking-wider text-sand-9 uppercase">Activity</p>
                <ul class="mt-1">
                  {[

---
import { locale as findLocale, locales, strings } from "../i18n";

interface Props {
  /** The page's content width, so the footer lines up with it. */
  width?: string;
  /** The landing page's language; the pages beside it are in English. */
  locale?: string;
}
const { width = "max-w-6xl", locale = "en" } = Astro.props;
const home = findLocale(locale).path;
const all = strings(locale);
const t = all.footer;

type Link = { label: string; href: string };
const columns: { title: string; links: Link[] }[] = [
  {
    title: t.product,
    links: [
      { label: all.nav.plugins, href: `${home}#plugins` },
      { label: t.devices, href: `${home}#devices` },
      { label: t.calibre, href: `${home}#calibre` },
      { label: all.nav.docs, href: "/docs/" },
      { label: all.nav.changelog, href: "/changelog/" },
    ],
  },
  {
    title: t.contact,
    links: [
      { label: "X", href: "https://x.com/randyloop" },
      { label: "Telegram", href: "https://t.me/djyde" },
      { label: "GitHub", href: "https://github.com/djyde/dalibre" },
      { label: "hi@taonan.lu", href: "mailto:hi@taonan.lu" },
    ],
  },
];
const external = (href: string) => (href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {});
---

<footer class="border-t border-sand-4 text-sm">
  <div class:list={["mx-auto px-5", width]}>
    <div class="grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <a href={home} class="inline-flex items-center gap-2 font-medium tracking-tight">
          <img src="/icon.png" alt="" class="size-7" />
          Dalibre
        </a>
        <p class="mt-3 max-w-[16rem] leading-relaxed text-sand-11">
          {t.tagline}
        </p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="text-xs font-medium text-ink">{col.title}</p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sand-11 transition-colors hover:text-ink" {...external(l.href)}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <p class="text-xs font-medium text-ink">{t.moreApps}</p>
        <ul class="mt-4">
          <li>
            <a href="https://nowdex.app" target="_blank" rel="noopener" class="text-sand-11 transition-colors hover:text-ink">
              Nowdex
            </a>
            <p class="mt-0.5 text-xs leading-relaxed text-sand-9">{t.nowdex}</p>
          </li>
        </ul>
      </div>
    </div>

    <nav aria-label={t.language} class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-sand-4 py-5 text-xs">
      <span class="flex items-center gap-1.5 font-medium text-ink">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" /></svg>
        {t.language}
      </span>
      {
        locales.map((l) => (
          <a
            href={l.path}
            hreflang={l.lang}
            lang={l.lang}
            aria-current={l.code === locale ? "true" : undefined}
            class:list={["transition-colors hover:text-ink", l.code === locale ? "text-ink" : "text-sand-11"]}
          >
            {l.name}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-2 border-t border-sand-4 py-6 text-xs text-sand-9 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} Dalibre</span>
      <span>{t.disclaimer}</span>
    </div>
  </div>
</footer>

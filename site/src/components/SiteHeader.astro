---
import { locale as findLocale, strings } from "../i18n";

// The landing page's top bar, shared with the pages beside it.
interface Props {
  /** The page shown, marked in the links. */
  current?: "changelog";
  /** The landing page's language; the pages beside it are in English. */
  locale?: string;
}
const { current, locale = "en" } = Astro.props;
const home = findLocale(locale).path;
const t = strings(locale).nav;
---

<header class="sticky top-0 z-40 border-b border-sand-4/80 bg-paper/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href={home} class="flex items-center gap-2.5 font-medium tracking-tight">
      <img src="/icon.png" alt="" class="size-8" />
      Dalibre
    </a>
    <div class="flex items-center gap-1 text-sm text-sand-11 sm:gap-6">
      <a href={`${home}#both`} class="hidden hover:text-ink sm:inline">{t.agents}</a>
      <a href={`${home}#plugins`} class="hidden hover:text-ink sm:inline">{t.plugins}</a>
      <a href="/docs/" class="px-2 hover:text-ink sm:px-0">{t.docs}</a>
      <a
        href="/changelog/"
        class:list={["hidden hover:text-ink sm:inline", current === "changelog" && "text-ink"]}
        aria-current={current === "changelog" ? "page" : undefined}
      >{t.changelog}</a>
      <a href={`${home}#download`} class="rounded-full border border-sand-6 px-3 py-1 text-xs font-medium text-ink transition hover:border-sand-9">{t.download}</a>
      <a href="https://github.com/djyde/dalibre" aria-label="GitHub" class="p-1 transition hover:text-ink">
        <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>
  </nav>
</header>

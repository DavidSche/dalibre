---
// The Library — Shelf screen from the Figma file (node 22:4140), redrawn in
// HTML: a 1440×900 window scaled to fit, with the app's semantic colors.
// Covers come from Open Library (covers.openlibrary.org), stored in
// src/assets/covers and resized to WebP at build time.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** The requests the window plays, in the page's language. */
  demo: { working: string; scenes: { ask: string; done: string }[] };
}
const { demo } = Astro.props;

// Books that start without a cover; the demo's AI finds theirs.
const noCover = [8, 9];

const coverFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/covers/*.jpg", { eager: true });
const slugs = [
  "three-body", "dark-forest", "deaths-end", "foundation", "dune",
  "left-hand", "hongloumeng", "piranesi", "invisible-cities", "thinking",
  "name-of-the-rose", "klara", "neuromancer", "sicp", "snow-crash",
];

const C = {
  navy: "#1e2a4a",
  teal: "#2a5e6d",
  plum: "#55294b",
  rust: "#b4543a",
  cream: "#e6d9bd",
  olive: "#45543a",
};

export interface Book {
  title: string;
  author: string;
  color: string;
  h?: number;
  cover?: string;
  series?: string;
  publisher: string;
  published: string;
  language: string;
  tags: string[];
  formats: [string, string][];
  rating: number;
}

const books: Book[] = [
  { title: "The Three-Body Problem", author: "Liu Cixin", color: C.navy, series: "Remembrance of Earth's Past · 1", publisher: "Tor Books", published: "2014-11-11", language: "English", tags: ["Science Fiction", "Hard SF", "Chinese Literature", "Hugo Award"], formats: [["EPUB", "1.8 MB"], ["MOBI", "2.4 MB"]], rating: 4 },
  { title: "The Dark Forest", author: "Liu Cixin", color: C.teal, series: "Remembrance of Earth's Past · 2", publisher: "Tor Books", published: "2015-08-11", language: "English", tags: ["Science Fiction", "Hard SF"], formats: [["EPUB", "2.1 MB"]], rating: 5 },
  { title: "Death's End", author: "Liu Cixin", color: C.plum, series: "Remembrance of Earth's Past · 3", publisher: "Tor Books", published: "2016-09-20", language: "English", tags: ["Science Fiction", "Hard SF"], formats: [["EPUB", "2.6 MB"]], rating: 4 },
  { title: "Foundation", author: "Isaac Asimov", color: C.rust, series: "Foundation · 1", publisher: "Gnome Press", published: "1951", language: "English", tags: ["Science Fiction", "Classics"], formats: [["EPUB", "0.9 MB"], ["AZW3", "1.1 MB"]], rating: 4 },
  { title: "Dune", author: "Frank Herbert", color: C.cream, series: "Dune · 1", publisher: "Chilton Books", published: "1965", language: "English", tags: ["Science Fiction", "Classics"], formats: [["EPUB", "1.4 MB"], ["PDF", "6.2 MB"]], rating: 5 },
  { title: "The Left Hand of Darkness", author: "Ursula K. Le Guin", color: C.olive, series: "Hainish Cycle", publisher: "Ace Books", published: "1969", language: "English", tags: ["Science Fiction", "Hugo Award"], formats: [["EPUB", "0.7 MB"]], rating: 4 },
  { title: "红楼梦", author: "曹雪芹", color: C.rust, publisher: "人民文学出版社", published: "1791", language: "Chinese", tags: ["Classics", "Chinese Literature"], formats: [["EPUB", "3.4 MB"]], rating: 5 },
  { title: "Piranesi", author: "Susanna Clarke", color: C.teal, publisher: "Bloomsbury", published: "2020-09-15", language: "English", tags: ["Fantasy", "Literary"], formats: [["EPUB", "1.1 MB"]], rating: 5 },
  { title: "Invisible Cities", author: "Italo Calvino", color: C.plum, publisher: "Harcourt Brace", published: "1974", language: "English", tags: ["Literary", "Classics"], formats: [["EPUB", "0.6 MB"]], rating: 5 },
  { title: "Thinking, Fast and Slow", author: "Daniel Kahneman", color: C.cream, publisher: "Farrar, Straus and Giroux", published: "2011-10-25", language: "English", tags: ["Non-fiction", "Psychology"], formats: [["PDF", "4.8 MB"]], rating: 4 },
  { title: "The Name of the Rose", author: "Umberto Eco", color: C.navy, publisher: "Harcourt", published: "1983", language: "English", tags: ["Literary", "Mystery"], formats: [["EPUB", "1.5 MB"]], rating: 4 },
  { title: "Klara and the Sun", author: "Kazuo Ishiguro", color: C.olive, publisher: "Knopf", published: "2021-03-02", language: "English", tags: ["Literary", "Science Fiction"], formats: [["EPUB", "1.0 MB"]], rating: 4 },
  { title: "Neuromancer", author: "William Gibson", color: C.navy, series: "Sprawl · 1", publisher: "Ace Books", published: "1984", language: "English", tags: ["Science Fiction", "Cyberpunk", "Hugo Award"], formats: [["AZW3", "0.8 MB"]], rating: 4 },
  { title: "Structure and Interpretation of Computer Programs", author: "Abelson & Sussman", color: C.cream, publisher: "MIT Press", published: "1996", language: "English", tags: ["Non-fiction", "Programming"], formats: [["PDF", "9.8 MB"]], rating: 5 },
  { title: "Snow Crash", author: "Neal Stephenson", color: C.rust, publisher: "Bantam Books", published: "1992", language: "English", tags: ["Science Fiction", "Cyberpunk"], formats: [["EPUB", "1.3 MB"]], rating: 4 },
];

// As the app does: cover height follows the image at width 132, clamped 160–210.
const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
for (const [i, b] of books.entries()) {
  const meta = coverFiles[`../assets/covers/${slugs[i]}.jpg`].default;
  const img = await getImage({ src: meta, width: 304, format: "webp", quality: 82 });
  b.cover = img.src;
  b.h = Math.round(clamp((132 * meta.height) / meta.width, 160, 210));
}

const rows = [books.slice(0, 5), books.slice(5, 10), books.slice(10, 15)];

const I: Record<string, string> = {
  library: '<path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  open: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  layers: '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
  bookmark: '<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  network: '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  updown: '<path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  grid: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  list: '<path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/>',
  sort: '<path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/>',
  panel: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  more: '<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>',
  download: '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
  spinner: '<path d="M21 12a9 9 0 1 1-6.219-8.56"/>',
  sliders: '<path d="M21 4h-7"/><path d="M10 4H3"/><path d="M21 12h-9"/><path d="M8 12H3"/><path d="M21 20h-5"/><path d="M12 20H3"/><path d="M14 2v4"/><path d="M8 10v4"/><path d="M16 18v4"/>',
};
const icon = (n: string, size = 16, sw = 1.75) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[n]}</svg>`;

const nav = [
  { i: "library", t: "All books", n: "1,284", on: true },
  { i: "clock", t: "Recently added", n: "24" },
  { i: "open", t: "Reading", n: "6" },
  { i: "heart", t: "Favorites", n: "41" },
];
const formats = [
  { t: "EPUB", n: "1,102", c: "var(--epub)" },
  { t: "PDF", n: "214", c: "var(--pdf)" },
  { t: "MOBI", n: "96", c: "var(--mobi)" },
  { t: "AZW3", n: "37", c: "var(--azw3)" },
];
const browse = [
  { i: "user", t: "Authors", n: "612" },
  { i: "layers", t: "Series", n: "88" },
  { i: "tag", t: "Tags", n: "143" },
  { i: "bookmark", t: "Publishers", n: "201" },
];
const sources = [
  { i: "globe", t: "Project Gutenberg" },
  { i: "globe", t: "Standard Ebooks" },
  { i: "network", t: "Home server" },
];
const chips = ["All", "Science Fiction", "Literary", "Classics", "Non-fiction", "Philosophy"];
---

<div class="dw-wrap">
<div class="dw-frame" data-books={JSON.stringify(books)} data-demo={JSON.stringify(demo)}>
  <div class="dw" role="img" aria-label="The Dalibre library window: books on shelves, a sidebar and a detail panel">
    <!-- Sidebar -->
    <aside class="dw-side">
      <div class="dw-lights"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></div>
      <div class="dw-picker">
        <span class="dw-avatar">D</span>
        <span class="flex-1 leading-tight">
          <span class="block text-[13px] font-medium">Calibre Library</span>
          <span class="block text-[11px] text-[var(--t3)]">~/Books · 1,284 books</span>
        </span>
        <span class="text-[var(--t3)]" set:html={icon("chevron", 14)} />
      </div>

      <nav class="mt-5 space-y-px">
        {nav.map((n) => (
          <div class:list={["dw-item", n.on && "dw-item-on"]}>
            <span class="dw-ic" set:html={icon(n.i)} />
            <span class="flex-1">{n.t}</span>
            <span class="dw-count">{n.n}</span>
          </div>
        ))}
      </nav>

      <div class="dw-sec">Formats<span set:html={icon("chevron", 12)} /></div>
      {formats.map((f) => (
        <div class="dw-item">
          <span class="dw-ic" style={`color:${f.c}`} set:html={icon("file")} />
          <span class="flex-1">{f.t}</span>
          <span class="dw-count">{f.n}</span>
        </div>
      ))}

      <div class="dw-sec">Browse<span set:html={icon("chevron", 12)} /></div>
      {browse.map((n) => (
        <div class="dw-item">
          <span class="dw-ic" set:html={icon(n.i)} />
          <span class="flex-1">{n.t}</span>
          <span class="dw-count" data-count={n.t}>{n.n}</span>
        </div>
      ))}

      <div class="dw-sec">Get books<span set:html={icon("chevron", 12)} /></div>
      {sources.map((n) => (
        <div class="dw-item">
          <span class="dw-ic" set:html={icon(n.i)} />
          <span class="flex-1">{n.t}</span>
        </div>
      ))}

      <div class="dw-jobs">
        <span class="dw-spin text-[var(--accent)]" set:html={icon("spinner", 16, 2)} />
        <span class="flex-1">
          <span class="block text-[12px]">Downloading 2 of 5</span>
          <span class="mt-1.5 block h-[3px] rounded-full bg-[var(--hover)]"><span class="block h-full w-[56%] rounded-full bg-[var(--accent)]" /></span>
        </span>
        <span class="text-[var(--icon)]" set:html={icon("sliders")} />
      </div>
    </aside>

    <!-- Main -->
    <section class="dw-main">
      <header class="dw-toolbar">
        <h3 class="text-[20px] font-semibold tracking-[-0.01em]">All books <span class="ml-1 font-mono text-[12px] font-normal text-[var(--t3)]">1,284</span></h3>
        <div class="flex-1"></div>
        <span class="dw-agent"><i>CC</i>Claude Code<b></b></span>
        <div class="dw-search">
          <span set:html={icon("search", 14)} />
          <span class="flex-1">Search title, author, tag…</span>
          <span class="font-mono text-[11px]">⌘K</span>
        </div>
        <div class="dw-seg"><span class="dw-seg-on" set:html={icon("grid", 15)} /><span set:html={icon("list", 15)} /></div>
        <span class="dw-btn-ghost" set:html={icon("sort", 15)} />
        <span class="dw-btn-ghost dw-btn-sel" set:html={icon("panel", 15)} />
        <span class="dw-primary"><span set:html={icon("plus", 14, 2)} />Add books</span>
      </header>

      <div class="dw-filters">
        {chips.map((c, i) => <span class:list={["dw-chip", i === 0 && "dw-chip-on"]} data-chip={i}>{c}</span>)}
        <span class="flex-1"></span>
        <span class="text-[12px] text-[var(--t2)]">Date added ↓</span>
      </div>

      <div class="dw-shelf">
        {rows.map((row, r) => (
          <div class="dw-row">
            <div class="dw-books">
              {row.map((b, i) => {
                const idx = r * 5 + i;
                return (
                  <button class:list={["dw-book", idx === 0 && "is-sel"]} data-i={idx} aria-label={b.title}>
                    <img class="dw-cover" src={b.cover} alt="" width="132" height={b.h} style={`height:${b.h}px;background:${b.color}`} loading={r === 0 ? "eager" : "lazy"} decoding="async" />
                    {noCover.includes(idx) && (
                      <span class="dw-ph" style={`height:${b.h}px;background:${b.color};color:${b.color === C.cream ? "#21201c" : "#fff"}`}>
                        <span class="dw-ph-author">{b.author}</span>
                        {b.title}
                      </span>
                    )}
                  </button>
                );
              })}
            </div>
            <div class="dw-plank"><span class="dw-plank-top"></span><span class="dw-plank-face"><span class="dw-marks">{row.map((_, i) => <span class:list={["dw-mark", r * 5 + i === 0 && "on"]} data-i={r * 5 + i} />)}</span></span><span class="dw-plank-lip"></span></div>
            <div class="dw-labels">
              {row.map((b, i) => (
                <div class:list={["dw-label", r * 5 + i === 0 && "on"]} data-i={r * 5 + i}>
                  <p class="dw-label-title">{b.title}</p>
                  <p class="dw-label-author">{b.author}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Detail -->
    <aside class="dw-detail">
      <div class="dw-detail-cover">
        <span class="dw-secondary dw-more" set:html={icon("more", 14)} />
        <img id="dw-d-cover" class="dw-cover" src={books[0].cover} alt="" width="152" style={`height:${Math.round((books[0].h! * 152) / 132)}px`} />
      </div>
      <h4 id="dw-d-title" class="mt-6 text-center text-[20px] leading-tight font-semibold tracking-[-0.01em]">{books[0].title}</h4>
      <p id="dw-d-author" class="mt-1.5 text-center text-[13px] text-[var(--t-accent)]">{books[0].author}</p>
      <p id="dw-d-stars" class="mt-1 text-center text-[12px] tracking-[2px] text-[#ffba18]">★★★★<span class="text-[var(--t3)]">☆</span></p>
      <div class="dw-hr"></div>
      <p class="dw-cap">Details</p>
      <dl id="dw-d-fields" class="dw-fields"></dl>
      <div id="dw-d-tags" class="mt-4 flex flex-wrap gap-1.5"></div>
      <div class="dw-hr"></div>
      <p class="dw-cap">Formats</p>
      <div id="dw-d-formats" class="space-y-1.5"></div>
    </aside>
  </div>
</div>

<script is:inline>
  // Scale the 1440-wide window to its frame before first paint.
  (function () {
    var f = document.currentScript.previousElementSibling;
    function fit() { f.style.setProperty("--s", String(f.clientWidth / 1440)); }
    fit();
    new ResizeObserver(fit).observe(f);
  })();
</script>

<!-- The demo's requests, shown beside what they change. They are labelled
     as coming from the visitor's own AI app: Dalibre itself has no chat. -->
<div class="dw-chat" aria-hidden="true">
  <span class="dw-chat-from"><b></b>Claude · MCP</span>
  <p class="dw-chat-user"></p>
  <p class="dw-chat-ai">
    <span class="dw-chat-spark" set:html={`<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>`} />
    <span class="dw-chat-text"></span>
  </p>
</div>
</div>

<script>
  import { animate, stagger } from "motion";

  type Book = {
    title: string; author: string; color: string; cover: string; h: number; series?: string; publisher: string;
    published: string; language: string; tags: string[]; formats: [string, string][]; rating: number;
  };
  const frame = document.querySelector<HTMLElement>(".dw-frame")!;
  const books: Book[] = JSON.parse(frame.dataset.books!);
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const dl = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>';

  function show(i: number) {
    const b = books[i];
    frame.querySelectorAll("[data-i]").forEach((el) =>
      el.classList.toggle(el.classList.contains("dw-book") ? "is-sel" : "on", Number((el as HTMLElement).dataset.i) === i),
    );
    const cover = $("dw-d-cover") as HTMLImageElement;
    cover.src = b.cover;
    cover.style.height = `${Math.round((b.h * 152) / 132)}px`;
    $("dw-d-title").textContent = b.title;
    $("dw-d-author").textContent = b.author;
    $("dw-d-stars").innerHTML = "★".repeat(b.rating) + `<span class="text-[var(--t3)]">${"☆".repeat(5 - b.rating)}</span>`;
    const rows: [string, string, boolean?][] = [
      ...(b.series ? [["Series", b.series] as [string, string]] : []),
      ["Publisher", b.publisher],
      ["Published", b.published, true],
      ["Language", b.language],
    ];
    $("dw-d-fields").innerHTML =
      rows.map(([k, v, mono]) => `<dt>${k}</dt><dd${mono ? ' class="font-mono"' : ""}>${esc(v)}</dd>`).join("") +
      `<dt>Identifiers</dt><dd class="text-[var(--t-accent)]">goodreads · amazon</dd>`;
    $("dw-d-tags").innerHTML = b.tags.map((t) => `<span class="dw-chip">${esc(t)}</span>`).join("");
    $("dw-d-formats").innerHTML = b.formats
      .map(
        ([f, size]) =>
          `<div class="dw-format"><span class="dw-badge" style="color:var(--${f.toLowerCase()});background:var(--${f.toLowerCase()}-bg)">${f}</span><span class="flex-1 truncate">${esc(b.title)}</span><span class="font-mono text-[11px] text-[var(--t3)]">${size}</span><span class="text-[var(--icon)]">${dl}</span></div>`,
      )
      .join("");
  }

  frame.querySelectorAll<HTMLElement>(".dw-book").forEach((el) =>
    el.addEventListener("click", () => show(Number(el.dataset.i))),
  );
  show(0);

  // The demo: requests to an AI, one after another, each with what it does
  // to the window. It plays while the window is on screen.
  const demo: { working: string; scenes: { ask: string; done: string }[] } = JSON.parse(frame.dataset.demo!);
  const wrap = frame.parentElement!;
  const chat = wrap.querySelector<HTMLElement>(".dw-chat")!;
  // Where each scene's bubbles sit: beside what the scene changes.
  const spots = [
    { x: "46.5%", y: "96%", tx: "-50%", ty: "-100%" }, // under the shelves
    { x: "35.6%", y: "80%", tx: "-50%", ty: "-100%" }, // below the three books
    { x: "58%", y: "97%", tx: "-50%", ty: "-100%" }, // below the two covers
    { x: "75.5%", y: "97%", tx: "-100%", ty: "-100%" }, // beside the formats
  ];
  const userB = wrap.querySelector<HTMLElement>(".dw-chat-user")!;
  const aiB = wrap.querySelector<HTMLElement>(".dw-chat-ai")!;
  const aiText = wrap.querySelector<HTMLElement>(".dw-chat-text")!;
  const agent = frame.querySelector<HTMLElement>(".dw-agent")!;
  const all = (sel: string) => [...frame.querySelectorAll<HTMLElement>(sel)];
  const parts = (i: number) => all(`.dw-book[data-i="${i}"], .dw-label[data-i="${i}"]`);
  const spring = { type: "spring", stiffness: 380, damping: 28 } as const;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  let onScreen = false;
  new IntersectionObserver(([e]) => (onScreen = e.isIntersecting), { threshold: 0.3 }).observe(frame);
  const whenWatched = async () => {
    while (!onScreen || document.hidden) await sleep(300);
  };

  const lift = (i: number, on: boolean) => frame.querySelector(`.dw-book[data-i="${i}"]`)!.classList.toggle("is-lift", on);

  const scenes: { run: () => Promise<void>; reset: () => Promise<void> }[] = [
    // "Show me my science fiction": the filter chip, and the rest fade.
    (() => {
      const chips = all("[data-chip]");
      const rest = books.flatMap((b, i) => (b.tags.includes("Science Fiction") ? [] : parts(i)));
      return {
        async run() {
          chips[0].classList.remove("dw-chip-on");
          chips[1].classList.add("dw-chip-on");
          animate(chips[1], { scale: [1.25, 1] }, spring);
          await animate(rest, { opacity: 0.14 }, { duration: 0.5, delay: stagger(0.025) });
        },
        async reset() {
          chips[1].classList.remove("dw-chip-on");
          chips[0].classList.add("dw-chip-on");
          await animate(rest, { opacity: 1 }, { duration: 0.4 });
        },
      };
    })(),
    // "Tag every Liu Cixin book": a tag lands on each, then in the details.
    (() => {
      const tag = "Chinese SF";
      const count = frame.querySelector<HTMLElement>('[data-count="Tags"]')!;
      const mine = books.flatMap((b, i) => (b.author === "Liu Cixin" ? [i] : []));
      let pops: HTMLElement[] = [];
      return {
        async run() {
          show(mine[0]);
          for (const i of mine) {
            lift(i, true);
            const pop = document.createElement("span");
            pop.className = "dw-tagpop";
            pop.textContent = tag;
            frame.querySelector(`.dw-book[data-i="${i}"]`)!.append(pop);
            pops.push(pop);
            animate(pop, { opacity: [0, 1], scale: [0.4, 1], y: [10, 0] }, spring);
            await sleep(380);
          }
          const chip = document.createElement("span");
          chip.className = "dw-chip dw-chip-on";
          chip.textContent = tag;
          $("dw-d-tags").append(chip);
          animate(chip, { opacity: [0, 1], scale: [0.5, 1] }, spring);
          count.textContent = "144";
          await animate(count, { scale: [1.5, 1] }, { duration: 0.6 });
        },
        async reset() {
          await animate(pops, { opacity: 0, y: -6 }, { duration: 0.25 });
          pops.forEach((p) => p.remove());
          pops = [];
          mine.forEach((i) => lift(i, false));
          count.textContent = "143";
          show(0);
        },
      };
    })(),
    // "Find covers": each bare cover gives way to the real one.
    (() => {
      const bare = all(".dw-ph");
      return {
        async run() {
          for (const ph of bare) {
            const i = Number(ph.parentElement!.dataset.i);
            lift(i, true);
            await animate(ph, { opacity: [1, 0], scale: [1, 1.06], filter: ["blur(0px)", "blur(8px)"] }, { duration: 0.7, ease: "easeOut" });
            await sleep(150);
            lift(i, false);
          }
        },
        async reset() {
          await animate(bare, { opacity: 1, scale: 1, filter: "blur(0px)" }, { duration: 0.4 });
        },
      };
    })(),
    // "Make a Kindle copy of Dune": the book opens, and gains a format.
    (() => {
      const dune = books.findIndex((b) => b.title === "Dune");
      return {
        async run() {
          show(dune);
          animate($("dw-d-cover"), { opacity: [0, 1], scale: [0.94, 1] }, { duration: 0.4 });
          await sleep(1300);
          const row = document.createElement("div");
          row.className = "dw-format dw-format-new";
          row.innerHTML = `<span class="dw-badge" style="color:var(--azw3);background:var(--azw3-bg)">AZW3</span><span class="flex-1 truncate">Dune</span><span class="font-mono text-[11px] text-[var(--t3)]">1.6 MB</span><span class="text-[var(--icon)]">${dl}</span>`;
          $("dw-d-formats").append(row);
          await animate(row, { opacity: [0, 1], y: [-14, 0], scale: [0.96, 1] }, spring);
        },
        async reset() {
          show(0);
        },
      };
    })(),
  ];

  const fadeIn = { opacity: [0, 1], y: [6, 0] };
  const soft = { duration: 0.45, ease: "easeOut" } as const;

  async function play() {
    for (let n = 0; ; n = (n + 1) % scenes.length) {
      await whenWatched();
      const text = demo.scenes[n];
      userB.textContent = text.ask;
      aiText.textContent = demo.working;
      for (const [k, v] of Object.entries(spots[n])) chat.style.setProperty(`--${k}`, v);
      animate(chat, fadeIn, soft);
      await animate(userB, fadeIn, soft);
      await sleep(300);

      aiB.classList.add("is-working");
      animate(agent, { opacity: [0, 1], scale: [0.9, 1] }, { duration: 0.3 });
      await animate(aiB, fadeIn, soft);
      await sleep(250);
      await scenes[n].run();
      await sleep(300);

      // The answer fades in where "Working…" was.
      await animate(aiB, { opacity: 0 }, { duration: 0.25 });
      aiText.textContent = text.done;
      aiB.classList.remove("is-working");
      animate(aiB, { opacity: 1 }, { duration: 0.45 });
      animate(agent, { opacity: 0 }, { duration: 0.3 });
      await sleep(2600);

      await whenWatched();
      await animate(chat, { opacity: 0 }, { duration: 0.35 });
      animate([userB, aiB], { opacity: 0 }, { duration: 0 });
      await scenes[n].reset();
      await sleep(500);
    }
  }
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) play();
</script>


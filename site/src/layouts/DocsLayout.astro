---
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import type { MarkdownHeading } from "astro";
import { nav, flat, href } from "../lib/docs-nav";
import Seo from "../components/Seo.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: MarkdownHeading[];
}

const { title, description, slug, headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const i = flat.findIndex((p) => p.slug === slug);
const prev = i > 0 ? flat[i - 1] : undefined;
const next = i >= 0 && i < flat.length - 1 ? flat[i + 1] : undefined;
const group = nav.find((g) => g.items.some((p) => p.slug === slug));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={slug ? `${title} · Dalibre Docs` : "Dalibre Docs"} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans">
    <header class="sticky top-0 z-40 border-b border-sand-4/80 bg-paper/85 backdrop-blur-md">
      <nav class="mx-auto flex h-14 max-w-[88rem] items-center justify-between px-5">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2.5 font-medium tracking-tight">
            <img src="/icon.png" alt="" class="size-7 rounded-md" />
            Dalibre
          </a>
          <span class="text-sand-7">/</span>
          <a href="/docs/" class="text-sm font-medium text-sand-11 hover:text-ink">Docs</a>
        </div>
        <div class="flex items-center gap-5 text-sm text-sand-11">
          <a href="/" class="hidden hover:text-ink sm:inline">Home</a>
          <a href="/docs/plugins/" class="hidden hover:text-ink sm:inline">Plugins</a>
          <a href="/changelog/" class="hidden hover:text-ink sm:inline">Changelog</a>
          <a href="/#download" class="rounded-full border border-sand-6 px-3 py-1 text-xs font-medium text-ink transition hover:border-sand-9">Download</a>
        </div>
      </nav>
    </header>

    <div class="mx-auto flex max-w-[88rem] px-5">
      <!-- Sidebar -->
      <aside class="hidden w-60 shrink-0 lg:block">
        <nav class="sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto py-10 pr-6 text-sm" aria-label="Docs">
          {nav.map((g) => (
            <div class="mb-8">
              <p class="mb-2 font-mono text-[11px] tracking-widest text-sand-9 uppercase">{g.title}</p>
              <ul class="space-y-0.5 border-l border-sand-4">
                {g.items.map((p) => (
                  <li>
                    <a
                      href={href(p.slug)}
                      class:list={[
                        "-ml-px block border-l py-1.5 pl-4 transition",
                        p.slug === slug
                          ? "border-accent font-medium text-accent"
                          : "border-transparent text-sand-11 hover:border-sand-7 hover:text-ink",
                      ]}
                      aria-current={p.slug === slug ? "page" : undefined}
                    >
                      {p.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Content -->
      <main class="min-w-0 flex-1 py-8 lg:border-l lg:border-sand-4 lg:py-12 lg:pl-12 xl:pr-12">
        <!-- Mobile page picker -->
        <details class="mb-8 rounded-xl border border-sand-6 bg-paper-2 text-sm lg:hidden">
          <summary class="cursor-pointer px-4 py-3 font-medium">
            <span class="text-sand-11">{group?.title} /</span> {title}
          </summary>
          <div class="border-t border-sand-6 px-4 py-3">
            {nav.map((g) => (
              <div class="mb-4 last:mb-0">
                <p class="mb-1 font-mono text-[11px] tracking-widest text-sand-9 uppercase">{g.title}</p>
                <ul>
                  {g.items.map((p) => (
                    <li>
                      <a href={href(p.slug)} class:list={["block py-1.5", p.slug === slug ? "font-medium text-accent" : "text-sand-11"]}>{p.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>

        <article class="mx-auto max-w-3xl">
          {group && <p class="font-mono text-xs tracking-widest text-violet uppercase">{group.title}</p>}
          <h1 class="mt-3 font-serif text-5xl leading-[1.05] tracking-tight sm:text-[56px]">{title}</h1>
          <p class="mt-4 text-lg leading-relaxed text-sand-11">{description}</p>
          <div class="prose mt-10">
            <slot />
          </div>

          <nav class="mt-16 grid gap-4 border-t border-sand-4 pt-8 sm:grid-cols-2" aria-label="Pagination">
            {prev ? (
              <a href={href(prev.slug)} class="group rounded-xl border border-sand-6 px-5 py-4 transition hover:border-sand-9">
                <span class="text-xs text-sand-9">← Previous</span>
                <span class="mt-1 block font-medium group-hover:text-accent">{prev.title}</span>
              </a>
            ) : <span />}
            {next && (
              <a href={href(next.slug)} class="group rounded-xl border border-sand-6 px-5 py-4 text-right transition hover:border-sand-9 sm:col-start-2">
                <span class="text-xs text-sand-9">Next →</span>
                <span class="mt-1 block font-medium group-hover:text-accent">{next.title}</span>
              </a>
            )}
          </nav>
        </article>
      </main>

      <!-- On this page -->
      <aside class="hidden w-56 shrink-0 xl:block">
        {toc.length > 1 && (
          <nav class="sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto py-12 text-[13px]" aria-label="On this page">
            <p class="mb-3 font-mono text-[11px] tracking-widest text-sand-9 uppercase">On this page</p>
            <ul class="space-y-1.5">
              {toc.map((h) => (
                <li class:list={[h.depth === 3 && "pl-3"]}>
                  <a href={`#${h.slug}`} data-toc={h.slug} class="toc-link block text-sand-11 transition hover:text-ink">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>
    </div>

    <Footer width="max-w-[88rem]" />

    <script>
      // Highlight the section being read in "On this page".
      const links = new Map<string, HTMLElement>();
      document.querySelectorAll<HTMLElement>(".toc-link").forEach((a) => links.set(a.dataset.toc!, a));
      const heads = [...document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]")];
      if (links.size && heads.length) {
        const visible = new Set<string>();
        const mark = () => {
          const current = heads.find((h) => visible.has(h.id))?.id;
          if (!current) return;
          links.forEach((a, id) => a.classList.toggle("is-active", id === current));
        };
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
            mark();
          },
          { rootMargin: "-64px 0px -60% 0px" },
        );
        heads.forEach((h) => io.observe(h));
      }
    </script>
  </body>
</html>
